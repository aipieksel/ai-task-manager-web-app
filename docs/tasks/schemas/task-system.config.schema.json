{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-system.config.schema.json",
  "type": "object",
  "required": [
    "schema",
    "version",
    "codexGoal",
    "review",
    "lifecycle",
    "planning"
  ],
  "properties": {
    "schema": {
      "const": "codex-task-system-config/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "codexGoal": {
      "type": "object",
      "required": [
        "enabled",
        "requirePlanEndGoal"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "requirePlanEndGoal": {
          "type": "boolean"
        },
        "disabledBehavior": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": [
        "requireIndependentR1",
        "autoSpawnSubagent",
        "waitForSpawnedReviewer",
        "whenAutoSpawnDisabled"
      ],
      "properties": {
        "requireIndependentR1": {
          "type": "boolean"
        },
        "autoSpawnSubagent": {
          "type": "boolean"
        },
        "waitForSpawnedReviewer": {
          "type": "boolean"
        },
        "whenAutoSpawnDisabled": {
          "enum": [
            "move-to-review-and-stop",
            "move-to-review-and-request-assignment"
          ]
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "userVerification"
      ],
      "properties": {
        "userVerification": {
          "type": "object",
          "required": [
            "treatAsDoneForAgentWork",
            "excludeFromActiveAssignment",
            "requireExplicitFailureToReopen",
            "doNotMarkDirtyBecauseStillInUserVerification"
          ],
          "properties": {
            "treatAsDoneForAgentWork": {
              "type": "boolean"
            },
            "excludeFromActiveAssignment": {
              "type": "boolean"
            },
            "requireExplicitFailureToReopen": {
              "type": "boolean"
            },
            "doNotMarkDirtyBecauseStillInUserVerification": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "planning": {
      "type": "object",
      "required": [
        "defaultMode",
        "allowInvocationModeOverride",
        "supportedInvocationModes",
        "quickModeSafety"
      ],
      "properties": {
        "defaultMode": {
          "enum": [
            "auto",
            "quick",
            "standard",
            "full"
          ]
        },
        "allowInvocationModeOverride": {
          "type": "boolean"
        },
        "supportedInvocationModes": {
          "type": "array",
          "items": {
            "enum": [
              "quick",
              "standard",
              "full"
            ]
          },
          "minItems": 3
        },
        "quickModeSafety": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "description": "Schema for docs/tasks/task-system.config.yaml. The config file is YAML so it can carry comments, but values map to this JSON object shape."
}
